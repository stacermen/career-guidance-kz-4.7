# =========================================================================
# Backend
# =========================================================================
# PostgreSQL connection string for SQLAlchemy async engine (asyncpg driver).
# When running via docker-compose, the host is the postgres service name.
DATABASE_URL=postgresql+asyncpg://career:career@postgres:5432/careerdb

# AI provider: Pollinations.ai (free, OpenAI-compatible, no API key required).
# The defaults below work out-of-the-box — nothing to fill in.
# See https://pollinations.ai for the list of supported free models.
POLLINATIONS_URL=https://text.pollinations.ai/openai
POLLINATIONS_MODEL=openai
POLLINATIONS_TIMEOUT=300
POLLINATIONS_REFERER=career-guidance-kz

# Random secret used for any signed tokens / cookies the backend may issue.
SECRET_KEY=change-me-in-production-please

# Comma separated list of allowed CORS origins (no trailing slash).
CORS_ORIGINS=http://localhost:5173,http://localhost,http://localhost:80

# =========================================================================
# Postgres (used by the postgres service in docker-compose)
# =========================================================================
POSTGRES_USER=career
POSTGRES_PASSWORD=career
POSTGRES_DB=careerdb

# =========================================================================
# Frontend (Vite reads VITE_* prefixed vars)
# =========================================================================
# Base URL the frontend uses to talk to the backend. In production behind
# nginx this should be empty / same-origin so requests are proxied via /api.
VITE_API_URL=http://localhost:8000
